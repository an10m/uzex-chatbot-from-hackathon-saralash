# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model. The client falls back to the best available
# Flash model when this one is unavailable.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: path to the SQLite database built by app/build_db.py.
# UZEX_DB_PATH=/opt/uzex/data/uzex.sqlite

# Optional: where the bot writes its rotating log.
# LOG_FILE=/opt/uzex/logs/bot.log

# Optional but recommended: your Telegram chat ID. /stats and rate-limit
# alerts are enabled only for this ID. Send /id to the bot to find it.
# ADMIN_CHAT_ID=

LOG_LEVEL=INFO
